{
  "name": "kt-agent-monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"backend,frontend\" --kill-others-on-fail \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "cd backend && uv run uvicorn kt_agent.api.app:app --reload --port 8000",
    "dev:frontend": "cd frontend && pnpm frontend-dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
